# ─────────────────────────────────────────
# 文档比对系统 — Docker 部署环境变量
# 复制为 .env 并按需修改,然后 docker compose up -d
# ─────────────────────────────────────────
DC_VERSION=0.0.35
# 服务端口(映射到容器内 8000)
DC_PORT=8000

# —— Postgres ——
# docker-compose 内置 postgres 服务会以该密码创建 dc 用户与 doc_compare 库。
# 应用容器由 compose 自动注入 DATABASE_URL,无需在此手动配置。
# 仅在容器外或独立运行时才需要显式设置 DATABASE_URL:
# DATABASE_URL=postgresql+psycopg://dc:dcpass@localhost:5432/doc_compare
POSTGRES_PASSWORD=dcpass
# 启动时自动 alembic upgrade head(默认开)。设为 0 可改为手动控制:
# DC_DB_AUTO_MIGRATE=1
# 连接池参数(每个 worker 独立持有;启用多 worker 时需确认 PG max_connections 足够,
# 默认 100;N workers × (pool+overflow) = N × 15)。
DC_DB_POOL_SIZE=5
DC_DB_MAX_OVERFLOW=10
DC_DB_POOL_TIMEOUT=30.0

# —— 并发与多 worker ——
# 全局并发任务上限(跨 worker 统一,由 PG task_records 计数强制)。
# 代码无硬性上限校验,但实际受三道瓶颈约束,设太大反而拖垮系统:
#   ① asyncio 默认线程池(单 worker 内):max_workers = min(32, cpu+4)。
#     pipeline 是同步阻塞的,经 asyncio.to_thread 丢进此池;超过池上限的任务
#     只是在 to_thread 排队,表面"并发 N"实际同时跑的仍是 cpu+4 个。
#     (本机 cpu=10 → 池上限 14;容器未限 cpus 时继承宿主机。)
#   ② 外部 OCR/LLM 服务 QPS:单任务内部 OCR 默认 4 路逐页并发
#     (llm_max_concurrency=4),故 N 个任务 = N×4 路并发请求,通常先于本系统触顶。
#   ③ DB 连接池:见上方 DC_DB_POOL_*,多 worker 下 N × (pool+overflow)。
# 推荐值:单 worker 保持 4(默认);想榨干单机可设 8–14(接近线程池上限,再大无收益);
#         多 worker 时每 worker 4–8,总并发 ≤ 上游服务 QPS。
# 调大征兆:任务 elapsed 不降反升 / OCR timeout·429 / CPU 满载但吞吐不涨 → 往下调。
DC_MAX_CONCURRENT_TASKS=4
# 获取执行槽位(asyncio.Semaphore)的最长等待秒数。
# 同步模式(sync=true)在并发已满时会排队等槽位;此处超时则任务直接置 failed,
# 防止请求永久 hang(gunicorn timeout=0 不兜底)。0=不等待。
DC_TASK_ACQUIRE_TIMEOUT=30.0
# gunicorn worker 数(默认 1=单进程,与现状一致;>1 启用多 worker)。
# 多 worker 下任务提交/执行/SSE/查询可落在不同 worker,已通过 PG 共享状态;
# SSE 进度粒度降为里程碑级(约 6-10 个节点/任务)。
# worker 数建议 = (2 ~ 4) × CPU 核数;每 worker 独立持有 DB 连接池与 asyncio 线程池。
DC_UVICORN_WORKERS=1



