# ─────────────────────────────────────────
# 文档比对系统 — Docker 部署环境变量
# 复制为 .env 并按需修改,然后 docker compose up -d
# ─────────────────────────────────────────

# 服务端口(映射到容器内 8000)
DC_PORT=8000

# —— Postgres ——
# docker-compose 内置 postgres 服务会以该密码创建 dc 用户与 doc_compare 库。
# 应用容器由 compose 自动注入 DATABASE_URL,无需在此手动配置。
# 仅在容器外或独立运行时才需要显式设置 DATABASE_URL:
# DATABASE_URL=postgresql+psycopg://dc:dcpass@localhost:5432/doc_compare
POSTGRES_PASSWORD=dcpass
# 启动时自动 alembic upgrade head(默认开)。设为 0 可改为手动控制:
# DC_DB_AUTO_MIGRATE=1

# —— LLM / OCR 配置请勿使用环境变量 ——
# 统一在 UI 设置页维护,持久化于 Postgres 的 llm_config 表
# (API Base / API Key / 模型名 / 超时 / 并发等)
# 首次启动若旧 .dc_data/llm_config.json 存在且 PG 无记录,会自动导入并保留文件作备份。

# —— 持久化数据与日志 ——
# docker-compose 把宿主 ./data 绑定到容器 /app/.dc_data:
#   - uploads / reports(应用文件)
#   - logs/app.log(应用日志)
#   - pg/(postgres 数据目录,含任务记录/报告/LLM 配置)
# 日志查看:tail -f ./data/logs/app.log
# 滚动:单文件 10MB、保留 5 个;级别由 DC_LOG_LEVEL 控制(默认 INFO,可设 DEBUG)。

# —— 时区 ——
# 容器默认 Asia/Shanghai(Dockerfile 内置);如需改,取消下行注释。
# TZ=Asia/Shanghai
