# ─────────────────────────────────────────
# 文档比对系统 — Docker 部署环境变量
# 复制为 .env 并按需修改,然后 docker compose up -d
# ─────────────────────────────────────────

# 服务端口(映射到容器内 8000)
DC_PORT=8000

# 认证:逗号分隔的合法 API Key。生产务必替换!
DC_API_KEYS=dev-key-please-change

# —— OCR 引擎 ——
# mock:不调用外部服务,用于测试 / 演示
# vllm / paddle / llm:调用远端多模态推理服务
DC_OCR_BACKEND=mock

# —— 远端 LLM / VLM 推理 ——
# 兼容 OpenAI Chat Completions 协议(vLLM / SGLang / 云端 API)
DC_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DC_LLM_API_KEY=
DC_LLM_MODEL=qwen-vl-max
DC_LLM_TIMEOUT=120
DC_LLM_MAX_CONCURRENCY=4

# —— 向量引擎(条款语义对齐用)——
# mock:随机向量; bge:FlagEmbedding(需额外安装)
DC_EMBED_BACKEND=mock
